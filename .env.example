# ── Evolution API ───────────────────────────────────────────────────
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=your-api-key-here
EVOLUTION_INSTANCE=bcomm-main

# ── LLM (OpenCode Go / vLLM / Ollama) ─────────────────────────────
OPENCODE_API_KEY=
OPENCODE_API_URL=http://localhost:11434/v1
OPENCODE_MODEL=mimo-v2.5

# ── Server ──────────────────────────────────────────────────────────
PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# ── Rate Limiting ───────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=20

# ── STT (Speech-to-Text via Whisper via OpenRouter) ────────────────
STT_API_URL=https://openrouter.ai/api/v1
STT_API_KEY=
STT_MODEL=openai/whisper-1

# ── Multi-tenant ────────────────────────────────────────────────────
ENABLE_MULTI_TENANT=false
DEFAULT_CLIENT=BCOMM
